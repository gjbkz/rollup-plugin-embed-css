{
    "name": "rollup-plugin-embed-css",
    "version": "1.0.26",
    "description": "Embed CSS into JavaScript",
    "main": "lib/index.js",
    "files": [
        "lib",
        "!*.test.*"
    ],
    "author": {
        "name": "Kei Ito",
        "email": "kei.itof@gmail.com",
        "url": "https://github.com/kei-ito"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=12"
    },
    "repository": "kei-ito/rollup-plugin-embed-css",
    "scripts": {
        "lint": "biome lint src test",
        "build": "run-s build:*",
        "build:tsc": "tsc --project tsconfig.build.json",
        "test": "ts-node test/index.ts",
        "version": "run-s version:*",
        "version:changelog": "npx nlib-changelog --output CHANGELOG.md",
        "version:add": "git add ."
    },
    "dependencies": {
        "esifycss": "1.4.40",
        "postcss": "8.5.32",
        "rollup-pluginutils": "2.8.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.7",
        "@nlib/changelog": "0.4.3",
        "@nlib/githooks": "0.2.2",
        "@nlib/lint-commit": "0.2.0",
        "@rollup/plugin-commonjs": "24.1.0",
        "@types/connect": "3.4.38",
        "@types/node": "18.19.130",
        "@types/selenium-webdriver": "4.35.7",
        "@types/serve-static": "1.15.10",
        "connect": "3.7.0",
        "lint-staged": "13.3.0",
        "npm-run-all": "4.1.5",
        "rollup": "3.30.0",
        "selenium-webdriver": "4.52.0",
        "serve-static": "1.16.3",
        "systemjs": "6.15.1",
        "ts-node": "10.9.2",
        "typescript": "4.9.5"
    },
    "lint-staged": {
        "*.ts": [
            "biome lint --no-errors-on-unmatched"
        ]
    },
    "renovate": {
        "extends": [
            "github>nlibjs/renovate-config"
        ]
    },
    "overrides": {
        "esifycss": {
            "postcss": "8.5.32",
            "chokidar": "3.6.0",
            "postcss-selector-parser": "6.1.6"
        },
        "@nlib/lint-commit": {
            "semver": "7.8.6"
        },
        "lint-staged": {
            "micromatch": "4.0.8",
            "yaml": "2.9.1"
        }
    }
}
